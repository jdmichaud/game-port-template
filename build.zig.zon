.{
    .name = .gameport,
    .version = "0.1.0",
    // Each port has its own: the rename of README.md puts in the value that `zig build`
    // suggests for the new name.
    .fingerprint = 0x15a057f38600fd95,
    // build.zig stops on another Zig release or a development snapshot of this one.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // SDL3 built from source by Zig, for Linux and Windows alike (build.zig).
        .sdl3 = .{
            .url = "git+https://github.com/allyourcodebase/SDL#540fe66af2ca5050fc1aabdf7a19cf462ea0312e",
            .hash = "sdl-1.0.2+3.4.16-i4QD0fCvqQBBggvApPLDHmSCoZSBDZALnEyM9m_-CQXY",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "docs",
        "README.md",
    },
}
